# /home/debian/.config/systemd/user/waytoys.service
# Managed by Waytoys
[Unit]
Description=Waytoys desktop tools
PartOf=graphical-session.target
After=graphical-session-pre.target plasma-kwin_wayland.service

[Service]
Type=simple
ExecStart="/home/debian/projects/way-toys/target/debug/waytoys" --background --app-config-dir "/home/debian/waytoys-test-results/settings-23/app" --config-dir "/home/debian/waytoys-test-results/settings-23/zones"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
